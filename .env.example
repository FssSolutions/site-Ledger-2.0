# Copy to .env.local (never commit real values). Names only.
# Public values: shipped in the browser bundle by design. Access is
# controlled by Row Level Security, not by keeping these secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put these in a VITE_* variable or in this file for the frontend.
# They are server-side secrets, set with `supabase secrets set`:
#   OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, ALLOWED_ORIGINS,
#   QBO_CLIENT_ID, QBO_CLIENT_SECRET, QBO_ENV, QBO_REDIRECT_URI, QBO_TOKEN_KEY, APP_URL
